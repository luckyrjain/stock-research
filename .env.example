# ── PostgreSQL (SME EMA pipeline) ────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/sme_research

# ── Redis (shared rate limiting / concurrency guards) ────────────────────────
# Backs rate_limiter.py's sliding-window rate limits, the LLM concurrency
# ceiling, and the SME refresh lock. Optional for a single backend
# worker/process (everything falls back to the same in-memory behavior this
# app had before Redis support existed) — only load-bearing once you scale
# the backend past one worker/replica, where an unset REDIS_URL means each
# worker gets its own counters again (see docs/deployment.md's "Scaling"
# section). Docker Compose sets this automatically to point at its own
# redis service.
# REDIS_URL=redis://localhost:6379/0

# ── Account & magic-link auth ────────────────────────────────────────────────
# Requires DATABASE_URL above (users/magic_links/sessions tables). The
# canonical frontend origin — embedded in the sign-in link emailed to users,
# since /auth/verify must run in the browser on the frontend's own origin to
# receive the session cookie. Defaults to the Next.js dev server.
# FRONTEND_URL=http://localhost:3000
#
# Generic SMTP — any provider works (Gmail app password, a self-hosted mail
# server, an SES SMTP endpoint, etc.). Without SMTP_HOST set, sign-in links
# are generated and stored but never emailed (logged as a warning) — the
# request still returns success, so this failure mode isn't distinguishable
# to the caller.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASSWORD=...
# SMTP_FROM=noreply@yourdomain.com
# SMTP_USE_TLS=true   # set to false only for a local/dev relay without TLS

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the FastAPI backend directly.
# Defaults to http://localhost:3000 (the Next.js dev server). Only matters for
# a genuine cross-origin browser request — the Next.js proxy routes talk to
# the backend server-to-server, which CORS doesn't apply to.
# ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ── Provider selection ────────────────────────────────────────────────────────
# Set LLM_PROVIDER explicitly, or leave unset for auto-detection.
# Auto-detection checks API keys in order: anthropic → openai → groq → google → openrouter
# Ollama (local) must be set explicitly: LLM_PROVIDER=ollama
#
# Supported values: anthropic | openai | groq | google | openrouter | ollama
# LLM_PROVIDER=groq

# ── API keys — set only the one you need ─────────────────────────────────────

# Anthropic (paid)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (paid)
# OPENAI_API_KEY=sk-...

# Groq — free tier at console.groq.com
# GROQ_API_KEY=gsk_...

# Google Gemini — free tier at aistudio.google.com
# GOOGLE_API_KEY=AIza...

# OpenRouter — access 300+ models via one API key (openrouter.ai)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# ANALYST_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct

# ── Ollama (local, no API key needed) ────────────────────────────────────────
# Install: https://ollama.com  →  ollama pull llama3.1:8b
# Stock analysis only — market picks doesn't support Ollama.
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434   # default, override if remote
# ANALYST_MODEL=ollama/llama3.1:8b

# ── Model override (optional) ────────────────────────────────────────────────
# Override the analyst model — used for both the stock-analysis recommendation
# and market picks' extraction/analysis LLM calls. Data fetching doesn't call
# an LLM, so there's no separate "data agent" model to configure.
# ANALYST_MODEL=groq/llama-3.3-70b-versatile

# ── Default models per provider ───────────────────────────────────────────────
# Provider     │ ANALYST_MODEL default
# -------------│------------------------------------------
# anthropic    │ claude-sonnet-4-6
# openai       │ gpt-4o
# groq         │ groq/llama-3.3-70b-versatile
# google       │ gemini/gemini-2.5-flash
# openrouter   │ openrouter/meta-llama/llama-3.3-70b-instruct
# ollama       │ ollama/llama3.1:8b
