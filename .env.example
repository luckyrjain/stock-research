# ── Provider selection ────────────────────────────────────────────────────────
# Set LLM_PROVIDER explicitly, or leave unset for auto-detection.
# Auto-detection checks API keys in order: anthropic → openai → groq → google
# Ollama (local) must be set explicitly: LLM_PROVIDER=ollama
#
# Supported values: anthropic | openai | groq | google | ollama
# LLM_PROVIDER=groq

# ── API keys — set only the one you need ─────────────────────────────────────

# Anthropic (paid)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (paid)
# OPENAI_API_KEY=sk-...

# Groq — free tier at console.groq.com
# GROQ_API_KEY=gsk_...

# Google Gemini — free tier at aistudio.google.com
# GOOGLE_API_KEY=AIza...

# ── Ollama (local, no API key needed) ────────────────────────────────────────
# Install: https://ollama.com  →  ollama pull llama3.2
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434   # default, override if remote
# LLM_MODEL=ollama/llama3.2               # model for data agents
# ANALYST_MODEL=ollama/llama3.1:8b        # model for analyst agent

# ── Model overrides (optional) ───────────────────────────────────────────────
# Override the default model for data-fetching agents (tasks 1–5):
# LLM_MODEL=groq/llama-3.1-8b-instant

# Override the model for the analyst agent (task 6, recommendation):
# ANALYST_MODEL=groq/llama-3.3-70b-versatile

# ── Default models per provider ───────────────────────────────────────────────
# Provider   │ Data agents              │ Analyst agent
# -----------│--------------------------│---------------------------
# anthropic  │ claude-haiku-4-5-20251001│ claude-sonnet-4-6
# openai     │ gpt-4o-mini              │ gpt-4o
# groq       │ llama-3.1-8b-instant     │ llama-3.3-70b-versatile
# google     │ gemini-1.5-flash         │ gemini-1.5-flash
# ollama     │ llama3.2                 │ llama3.1:8b
