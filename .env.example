# ── PostgreSQL (SME EMA pipeline) ────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/sme_research

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the FastAPI backend directly.
# Defaults to http://localhost:3000 (the Next.js dev server). Only matters for
# a genuine cross-origin browser request — the Next.js proxy routes talk to
# the backend server-to-server, which CORS doesn't apply to.
# ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ── Provider selection ────────────────────────────────────────────────────────
# Set LLM_PROVIDER explicitly, or leave unset for auto-detection.
# Auto-detection checks API keys in order: anthropic → openai → groq → google → openrouter
# Ollama (local) must be set explicitly: LLM_PROVIDER=ollama
#
# Supported values: anthropic | openai | groq | google | openrouter | ollama
# LLM_PROVIDER=groq

# ── API keys — set only the one you need ─────────────────────────────────────

# Anthropic (paid)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (paid)
# OPENAI_API_KEY=sk-...

# Groq — free tier at console.groq.com
# GROQ_API_KEY=gsk_...

# Google Gemini — free tier at aistudio.google.com
# GOOGLE_API_KEY=AIza...

# OpenRouter — access 300+ models via one API key (openrouter.ai)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# LLM_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct   # data agents
# ANALYST_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct  # analyst

# ── Ollama (local, no API key needed) ────────────────────────────────────────
# Install: https://ollama.com  →  ollama pull llama3.2
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434   # default, override if remote
# LLM_MODEL=ollama/llama3.2               # model for data agents
# ANALYST_MODEL=ollama/llama3.1:8b        # model for analyst agent

# ── Model overrides (optional) ───────────────────────────────────────────────
# Override the default model for data-fetching agents (tasks 1–5):
# LLM_MODEL=groq/llama-3.1-8b-instant

# Override the model for the analyst agent (task 6, recommendation):
# ANALYST_MODEL=groq/llama-3.3-70b-versatile

# ── Default models per provider ───────────────────────────────────────────────
# Provider     │ Data agents                              │ Analyst agent
# -------------│------------------------------------------│------------------------------------------
# anthropic    │ claude-haiku-4-5-20251001                │ claude-sonnet-4-6
# openai       │ gpt-4o-mini                              │ gpt-4o
# groq         │ groq/llama-3.1-8b-instant                │ groq/llama-3.3-70b-versatile
# google       │ gemini/gemini-2.5-flash                  │ gemini/gemini-2.5-flash
# openrouter   │ openrouter/meta-llama/llama-3.1-8b-instruct │ openrouter/meta-llama/llama-3.3-70b-instruct
# ollama       │ ollama/llama3.2                          │ ollama/llama3.1:8b
